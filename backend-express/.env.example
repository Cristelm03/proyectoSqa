# Copia este archivo a .env y completa los valores. El archivo .env no se sube al repositorio.

# Conexion a MySQL (la usa Prisma)
DATABASE_URL="mysql://usuario:contrasena@localhost:3306/db_express"

# Secreto para firmar los JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Puerto de la API (opcional, por defecto 3000)
PORT=3000

# Origenes permitidos por CORS, separados por coma (opcional; por defecto el servidor de Vite)
CORS_ORIGIN=http://localhost:5173
